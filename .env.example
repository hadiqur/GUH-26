# --- Database ----------------------------------------------------------------

# SQLite file used by app/db.py. Relative paths are from the repo root.
DATABASE_PATH=data/dialatext.db

# --- Dashboard (account website) ---------------------------------------------

# 1 = local demo: login codes are printed to the server log, SMS is only
# logged (never sent), and the login page shows a "Try the demo" button.
# Never set this in production.
DEMO_MODE=1

# The Dial-a-Text service number shown in the dashboard header (E.164).
# Probably shared with the Vonage config; use the same value.
VONAGE_NUMBER=+447700900000

# Public base URL. If it starts with https://, session cookies are marked Secure.
PUBLIC_URL=http://localhost:8001

# 1 = accept non-UK mobile numbers (same rule as the call flow).
ALLOW_INTERNATIONAL=0

# Secret key for hashing login codes. Any long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET=

# SQLite file the dashboard uses until it shares app/db.py. Default: ./dev.db
DASHBOARD_DB_PATH=
