# Copy to .env (git-ignored) and fill in. Used by scripts/test-webhooks.mjs.
# Vonage, ElevenLabs, Gmail and Google credentials live in n8n and the
# ElevenLabs UI, never in this repo.

# Base of the production webhook URLs, e.g. https://<instance>.app.n8n.cloud/webhook
N8N_WEBHOOK_BASE=
# Shared secret sent as the X-Tool-Secret header. Also set in n8n and ElevenLabs.
TOOL_SECRET=
# The Vonage number, E.164
VONAGE_NUMBER=
# Number of the seeded demo user, and one teammate who agreed to receive test texts
DEMO_USER_PHONE=+447700900123
TEST_RECIPIENT_PHONE=
